{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "/property:GenerateFullPaths=true", // Ask dotnet build to generate full paths for file names.
                "/consoleloggerparameters:'ForceNoAlign;NoSummary'" // Do not generate summary otherwise it leads to duplicate errors in Problems panel
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-yaml-linter",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Content.YAMLLinter/Content.YAMLLinter.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:'ForceNoAlign;NoSummary'"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--no-build",
                "--configuration",
                "DebugOpt",
                "Content.Tests/Content.Tests.csproj",
                "--",
                "NUnit.ConsoleOut=0"
            ],
            "group": {
                "kind": "test"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "integration-test",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--no-build",
                "--configuration",
                "DebugOpt",
                "Content.IntegrationTests/Content.IntegrationTests.csproj",
                "--",
                "NUnit.ConsoleOut=0",
                "NUnit.MapWarningTo=Failed.ConsoleOut=0",
                "NUnit.MapWarningTo=Failed"
            ],
            "group": {
                "kind": "test"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "wh40k: build content.shared",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "Content.Shared/Content.Shared.csproj",
                "-c",
                "Debug",
                "--no-restore",
                "/p:TreatWarningsAsErrors=false",
                "/p:UseAppHost=false"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "wh40k: build content.server (no deps)",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "Content.Server/Content.Server.csproj",
                "-c",
                "Debug",
                "--no-restore",
                "--no-dependencies",
                "/p:TreatWarningsAsErrors=false",
                "/p:UseAppHost=false"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "wh40k: render tactical map snapshot",
            "command": "powershell",
            "type": "shell",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Tools/render_wh40k_tactical_map.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "wh40k: find proto on battlefield40k",
            "command": "powershell",
            "type": "shell",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Tools/find_wh40k_map_proto.ps1",
                "-MapPath",
                "Resources/Maps/_WH40K/battlefield40k.yml",
                "-ProtoId",
                "${input:wh40kProtoId}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "wh40k: validate prep barriers",
            "command": "powershell",
            "type": "shell",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Tools/validate_wh40k_prep_barriers.ps1",
                "-MapPath",
                "Resources/Maps/_WH40K/battlefield40k.yml"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "wh40kProtoId",
            "type": "promptString",
            "description": "Prototype id to search inside battlefield40k.yml",
            "default": "WH40KWallWarningTDM"
        }
    ]
}
