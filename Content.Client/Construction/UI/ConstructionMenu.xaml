<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6" SeparationOverride="6">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="10 8" SeparationOverride="8" VerticalAlignment="Center">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                        <Label Name="HeaderTitleLabel" StyleClasses="LabelHeading" />
                        <Label Name="HeaderSubtitleLabel" StyleClasses="LabelSubText" />
                    </BoxContainer>
                    <Button Name="MenuGridViewButton" ToggleMode="True" MinWidth="140"/>
                    <PanelContainer Name="HeaderStatsBadge">
                        <BoxContainer Margin="9 4">
                            <Label Name="HeaderStatsLabel" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
                <PanelContainer Name="CatalogPanel" MinWidth="292" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6" VerticalExpand="True">
                        <PanelContainer Name="SearchPanel">
                            <BoxContainer Orientation="Vertical" Margin="7" SeparationOverride="5">
                                <Label Name="CatalogTitleLabel" StyleClasses="LabelHeading" />
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                                    <LineEdit Name="SearchBar" PlaceHolder="{Loc 'construction-menu-search'}" HorizontalExpand="True"/>
                                    <controls:ThemedOptionButton Name="OptionCategories" Access="Public" MinWidth="148"/>
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer Name="RecipeListPanel" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4" VerticalExpand="True">
                                <controls:ListContainer Name="Recipes" Access="Public" Group="True" Toggle="True" VerticalExpand="True" />
                                <ScrollContainer Name="RecipesGridScrollContainer" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Access="Public" Visible="False">
                                    <GridContainer Name="RecipesGrid" HorizontalExpand="True" Columns="3" HSeparationOverride="8" VSeparationOverride="8" Access="Public"/>
                                </ScrollContainer>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
                    <PanelContainer Name="DetailsHeroPanel">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8" SeparationOverride="6">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10" VerticalAlignment="Center">
                                <PanelContainer Name="PreviewFramePanel">
                                    <BoxContainer Margin="8" HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <EntityPrototypeView Name="TargetTexture" Stretch="Fill" MinSize="64 64" />
                                    </BoxContainer>
                                </PanelContainer>

                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5">
                                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6" VerticalAlignment="Center">
                                        <PanelContainer Name="TargetCategoryBadgePanel">
                                            <BoxContainer Margin="8 3">
                                                <Label Name="TargetCategoryBadgeLabel" />
                                            </BoxContainer>
                                        </PanelContainer>
                                        <Control HorizontalExpand="True" />
                                        <Button Name="FavoriteButton" Visible="False" MinWidth="148"/>
                                    </BoxContainer>

                                    <RichTextLabel Name="TargetName" />
                                    <RichTextLabel Name="TargetDesc" />
                                </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="RecipeStepPanel" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="8" SeparationOverride="6">
                            <BoxContainer Orientation="Vertical" SeparationOverride="2">
                                <Label Name="RequirementsTitleLabel" StyleClasses="LabelHeading" />
                                <Label Name="StepSummaryLabel" StyleClasses="LabelSubText" />
                            </BoxContainer>
                            <ItemList Name="RecipeStepList"
                                      Access="Public"
                                      VerticalExpand="True"
                                      Margin="0"
                                      StyleClasses="transparentItemList"/>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="BuildActionsPanel">
                        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                            <Label Name="ActionHintLabel" StyleClasses="LabelSubText" />
                            <Button Name="BuildButton" Disabled="True" ToggleMode="True" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                <Button Name="EraseButton" ToggleMode="True" HorizontalExpand="True" />
                                <Button Name="ClearButton" HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
