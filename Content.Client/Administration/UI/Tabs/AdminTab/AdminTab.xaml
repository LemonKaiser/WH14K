<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:at="clr-namespace:Content.Client.Administration.UI.Tabs.AdminTab"
    Margin="4"
    MinSize="50 50">
    <BoxContainer Orientation="Vertical">
        <GridContainer Columns="3">
            <cc:CommandButton Name="BanPanelButton" Command="banpanel" Text="{Loc admin-player-actions-window-ban}" />
            <cc:CommandButton Name="AdminGhostButton" Command="aghost" Text="{Loc admin-player-actions-window-admin-ghost}" />
            <cc:CommandButton Name="PermissionsButton" Command="permissions" Text="{Loc admin-player-actions-window-permissions}" />
            <cc:CommandButton Name="AnnounceButton" Command="announceui" Text="{Loc admin-player-actions-window-announce}"/>
            <cc:UICommandButton Name="ShuttleButton" Command="callshuttle" Text="{Loc admin-player-actions-window-shuttle}" WindowType="{x:Type at:AdminShuttleWindow}"/>
            <cc:CommandButton Name="AdminLogsButton" Command="adminlogs" Text="{Loc admin-player-actions-window-admin-logs}"/>
            <cc:UICommandButton Name="ScreenCheckButton" Command="screencheck" Text="{Loc admin-player-actions-window-screen-check}" WindowType="{x:Type at:ScreenCheckAdminWindow}"/>
            <cc:CommandButton Name="AdminFaxButton" Command="faxui" Text="{Loc admin-player-actions-window-admin-fax}"/>
            <cc:CommandButton Name="AdminChatButton" Command="achatwindow" Text="{Loc admin-player-actions-window-admin-chat}"/>
        </GridContainer>
    </BoxContainer>
</Control>
