<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    Orientation="Horizontal"
    HorizontalExpand="True"
    SeparationOverride="4">
    <Label Name="Id"
           Access="Public"
           SizeFlagsStretchRatio="1"
           HorizontalExpand="True"
           ClipText="True"/>
    <cc:VSeparator/>
    <Label Name="Type"
           Access="Public"
           SizeFlagsStretchRatio="2"
           HorizontalExpand="True"
           ClipText="True"/>
    <cc:VSeparator/>
    <Label Name="Reason"
           Access="Public"
           SizeFlagsStretchRatio="6"
           HorizontalExpand="True"
           VerticalExpand="True"/>
    <cc:VSeparator/>
    <Label Name="MuteTime"
           Access="Public"
           SizeFlagsStretchRatio="2"
           HorizontalExpand="True"
           ClipText="True"/>
    <cc:VSeparator/>
    <Label Name="Expires"
           Access="Public"
           SizeFlagsStretchRatio="4"
           HorizontalExpand="True"
           ClipText="True"/>
    <cc:VSeparator/>
    <Label Name="MutingAdmin"
           Access="Public"
           SizeFlagsStretchRatio="2"
           HorizontalExpand="True"
           ClipText="True"/>
</BoxContainer>
