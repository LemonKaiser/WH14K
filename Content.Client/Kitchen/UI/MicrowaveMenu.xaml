<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'microwave-menu-title'}"
                      MinSize="772 466"
                      SetSize="796 486"
                      Resizable="False">
    <BoxContainer Name="RootLayout"
                  Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <PanelContainer Name="RootFrame"
                        HorizontalExpand="True"
                        VerticalExpand="True">
            <BoxContainer Orientation="Vertical"
                          Margin="6 5 6 5"
                          SeparationOverride="6"
                          VerticalExpand="True">
                <PanelContainer Name="HeaderPanel">
                    <BoxContainer Orientation="Vertical"
                                  Margin="7 6 7 6"
                                  SeparationOverride="2">
                        <Label Name="HeaderTitleLabel"
                               Text="{Loc 'microwave-menu-title'}"
                               StyleClasses="LabelKeyText" />
                        <RichTextLabel Name="HeaderSubtitleLabel"
                                       Text="{Loc 'microwave-menu-header-subtitle'}"
                                       HorizontalExpand="True"
                                       StyleClasses="LabelSubText" />
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Horizontal"
                              SeparationOverride="6"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <PanelContainer Name="IngredientsPanel"
                                    HorizontalExpand="True"
                                    VerticalExpand="True"
                                    SizeFlagsStretchRatio="8.95">
                        <BoxContainer Orientation="Vertical"
                                      Margin="7 6 7 6"
                                      SeparationOverride="4"
                                      VerticalExpand="True">
                            <BoxContainer Orientation="Horizontal"
                                          SeparationOverride="6">
                                <Label Name="ChamberTitleLabel"
                                       Text="{Loc 'microwave-menu-chamber-title'}"
                                       HorizontalExpand="True"
                                       StyleClasses="LabelKeyText" />
                                <Label Name="IngredientCountLabel"
                                       Text="0"
                                       StyleClasses="LabelSubText" />
                            </BoxContainer>

                            <RichTextLabel Name="ChamberNoteLabel"
                                           Text="{Loc 'microwave-menu-chamber-note-ready'}"
                                           HorizontalExpand="True"
                                           StyleClasses="LabelSubText" />

                            <ContainerButton Name="PreviewActionButton"
                                             HorizontalExpand="True"
                                             VerticalExpand="True"
                                             MinHeight="220">
                                <BoxContainer Orientation="Vertical"
                                              Margin="6 5 6 5"
                                              SeparationOverride="5"
                                              VerticalExpand="True">
                                    <LayoutContainer Name="PreviewStageLayout"
                                                     HorizontalExpand="True"
                                                     VerticalExpand="True"
                                                     MinHeight="184">
                                        <PanelContainer Name="StageBackdropPanel"
                                                        HorizontalExpand="True"
                                                        VerticalExpand="True" />
                                        <TextureRect Name="PlateTextureRect"
                                                     Access="Public"
                                                     MinSize="236 128"
                                                     MaxSize="236 128"
                                                     Stretch="KeepAspectCentered"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                        <TextureRect Name="IngredientPreviewTextureRect"
                                                     Access="Public"
                                                     MinSize="162 116"
                                                     MaxSize="162 116"
                                                     Stretch="KeepAspectCentered"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                        <Label Name="IngredientPreviewPlaceholderLabel"
                                               Text="{Loc 'microwave-menu-chamber-empty'}"
                                               HorizontalExpand="True"
                                               VerticalExpand="True"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               StyleClasses="LabelSubText" />
                                    </LayoutContainer>

                                    <Label Name="SelectedIngredientLabel"
                                           Text="{Loc 'microwave-menu-chamber-empty'}"
                                           HorizontalAlignment="Center"
                                           HorizontalExpand="True"
                                           ClipText="True" />
                                    <RichTextLabel Name="SelectedIngredientHintLabel"
                                                   Text="{Loc 'microwave-menu-stage-hint-empty'}"
                                                   HorizontalExpand="True"
                                                   HorizontalAlignment="Center"
                                                   StyleClasses="LabelSubText" />
                                </BoxContainer>
                            </ContainerButton>

                            <PanelContainer Name="SelectorPanel"
                                            HorizontalExpand="True"
                                            MinHeight="58">
                                <BoxContainer Orientation="Vertical"
                                              Margin="6 5 6 5"
                                              SeparationOverride="3">
                                    <Label Name="SelectorTitleLabel"
                                           Text="{Loc 'microwave-menu-selector-title'}"
                                           StyleClasses="LabelSubText" />
                                    <GridContainer Name="IngredientSelectorGrid"
                                                   Columns="5"
                                                   HSeparationOverride="4"
                                                   VSeparationOverride="4"
                                                   HorizontalExpand="True" />
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="ControlPanel"
                                    MinWidth="208"
                                    MaxWidth="208"
                                    VerticalExpand="True">
                        <BoxContainer Orientation="Vertical"
                                      Margin="6 6 6 6"
                                      SeparationOverride="5"
                                      VerticalExpand="True">
                            <PanelContainer Name="StatusPanel">
                                <BoxContainer Orientation="Vertical"
                                              Margin="7 5 7 5"
                                              SeparationOverride="2">
                                    <Label Name="CookTimeInfoLabel"
                                            Access="Public"
                                           Text="{Loc 'microwave-menu-time-card-title'}"
                                           StyleClasses="LabelSubText" />
                                    <Label Name="CookTimeValueLabel"
                                           Access="Public"
                                           Text="{Loc 'microwave-menu-instant-button'}"
                                           ClipText="True"
                                           StyleClasses="LabelKeyText" />
                                    <Label Name="MachineStatusLabel"
                                           ClipText="True"
                                           Text="{Loc 'microwave-menu-status-empty'}" />
                                    <RichTextLabel Name="ModeStatusLabel"
                                                   Text="{Loc 'microwave-menu-mode-awaiting'}"
                                                   HorizontalExpand="True"
                                                   StyleClasses="LabelSubText" />
                                </BoxContainer>
                            </PanelContainer>

                            <PanelContainer Name="TimePanel">
                                <BoxContainer Orientation="Vertical"
                                              Margin="7 5 7 5"
                                              SeparationOverride="4">
                                    <Button Name="InstantCookButton"
                                            Access="Public"
                                            Text="{Loc 'microwave-menu-instant-button'}"
                                            ToggleMode="True"
                                            HorizontalExpand="True"
                                            MinHeight="28"
                                            TextAlign="Center" />
                                    <GridContainer Name="CookTimeButtonVbox"
                                                   Access="Public"
                                                   Columns="3"
                                                   HSeparationOverride="4"
                                                   VSeparationOverride="4"
                                                   HorizontalExpand="True">
                                        <!-- Buttons are added by code -->
                                    </GridContainer>
                                </BoxContainer>
                            </PanelContainer>

                            <Button Name="StartButton"
                                    Access="Public"
                                    Text="{Loc 'microwave-menu-start-button-wh40k'}"
                                    HorizontalExpand="True"
                                    MinHeight="30"
                                    TextAlign="Center" />
                            <Button Name="EjectButton"
                                    Access="Public"
                                    Text="{Loc 'microwave-menu-eject-all-text-wh40k'}"
                                    ToolTip="{Loc 'microwave-menu-eject-all-tooltip'}"
                                    HorizontalExpand="True"
                                    MinHeight="30"
                                    TextAlign="Center" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Name="FooterWrapper"
                      Orientation="Vertical"
                      VerticalAlignment="Bottom">
            <PanelContainer Name="FooterDivider" />

            <BoxContainer Name="FooterBar"
                          Orientation="Horizontal"
                          Margin="12 0 6 2"
                          VerticalAlignment="Bottom">
                <Label Name="FooterLeftLabel"
                       ClipText="True"
                       Text="{Loc 'microwave-menu-footer-ready'}"
                       StyleClasses="WindowFooterText" />

                <Label Name="FooterRightLabel"
                       ClipText="True"
                       Text="{Loc 'microwave-menu-footer-right'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right"
                       HorizontalExpand="True"
                       Margin="0 0 4 0" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>

    <PanelContainer Name="DisableCookingPanelOverlay"
                    Access="Public"
                    Visible="False"
                    MouseFilter="Ignore">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#0B0C10AA" />
        </PanelContainer.PanelOverride>
    </PanelContainer>
</controls:FancyWindow>
