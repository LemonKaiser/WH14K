<Control xmlns="https://spacestation14.io"
         MaxWidth="420">
    <PanelContainer Name="CardPanel">
        <BoxContainer Orientation="Vertical">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Vertical"
                              Margin="10 8 10 8">
                    <Label Name="TitleLabel"
                           StyleClasses="LabelKeyText"
                           ClipText="True" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Vertical"
                          Margin="10 8 10 10"
                          RectClipContent="True">
                <RichTextLabel Name="RecipeTooltipLabel"
                               HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
