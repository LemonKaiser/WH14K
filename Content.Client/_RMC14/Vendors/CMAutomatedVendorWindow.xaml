<controls:CMAutomatedVendorWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Vendors"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="560 680">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#0B0C10" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" SeparationOverride="0">
            <!-- ── LEFT: MAIN VENDOR ── -->
            <BoxContainer Orientation="Vertical" SeparationOverride="0"
                          HorizontalExpand="True" VerticalExpand="True">
                <!-- HEADER -->
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#0E0F14"
                                               BorderColor="#2E2718"
                                               BorderThickness="0 0 0 1"
                                               ContentMarginLeftOverride="14"
                                               ContentMarginRightOverride="14"
                                               ContentMarginTopOverride="10"
                                               ContentMarginBottomOverride="10" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" SeparationOverride="8">
                        <!-- Title + Points -->
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <Label Name="GearIcon" Access="Public" Text="⚙" FontColorOverride="#9E8540" />
                            <Label Text="COLMARTECH AUTOMATED VENDOR"
                                   FontColorOverride="#BFA555"
                                   StyleClasses="LabelHeading"
                                   HorizontalExpand="True" />
                            <Label Name="PointsLabel" Access="Public"
                                   FontColorOverride="#D4B44E" />
                        </BoxContainer>
                        <!-- Search -->
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#101218"
                                                       BorderColor="#252018"
                                                       BorderThickness="0 0 0 1"
                                                       ContentMarginLeftOverride="8"
                                                       ContentMarginRightOverride="8"
                                                       ContentMarginTopOverride="3"
                                                       ContentMarginBottomOverride="3" />
                            </PanelContainer.PanelOverride>
                            <LineEdit Name="Search"
                                      Access="Public"
                                      HorizontalExpand="True"
                                      PlaceHolder="{Loc 'cm-automated-vendor-ui-search-placeholder'}" />
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>
                <!-- CONTENT -->
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True"
                                 Margin="8 6 8 6">
                    <BoxContainer Orientation="Vertical" Name="Sections" Access="Public"
                                  SeparationOverride="4" />
                </ScrollContainer>
                <!-- BOTTOM LINE -->
                <PanelContainer Name="BottomAccent" Access="Public" MinHeight="2">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#4A3D20" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
            </BoxContainer>
            <!-- ── RIGHT: DETAIL PANEL ── -->
            <controls:CMAutomatedVendorDetail Name="DetailPanel" Access="Public" />
        </BoxContainer>
    </PanelContainer>
</controls:CMAutomatedVendorWindow>
