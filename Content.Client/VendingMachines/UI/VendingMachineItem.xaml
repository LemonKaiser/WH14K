<BoxContainer xmlns="https://spacestation14.io"
              Orientation="Horizontal"
              HorizontalExpand="True"
              SeparationOverride="10"
              Margin="10 8 10 8">
    <PanelContainer Name="IconFrame"
                    VerticalAlignment="Center">
        <EntityPrototypeView Name="ItemPrototype"
                             Margin="6 6 6 6"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             MinSize="40 40" />
    </PanelContainer>

    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  SeparationOverride="3"
                  VerticalAlignment="Center">
        <RichTextLabel Name="NameLabel"
                       HorizontalExpand="True" />
        <RichTextLabel Name="MetaLabel"
                       HorizontalExpand="True" />
    </BoxContainer>

    <PanelContainer Name="AmountBadge"
                    MinWidth="76"
                    VerticalAlignment="Center">
        <Label Name="AmountLabel"
               Margin="10 7 10 7"
               HorizontalAlignment="Center"
               Align="Center" />
    </PanelContainer>
</BoxContainer>
