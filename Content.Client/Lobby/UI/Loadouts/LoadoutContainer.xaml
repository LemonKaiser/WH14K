<BoxContainer Name="Container" xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:lobby="clr-namespace:Content.Client.Lobby.UI"
         xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         Orientation="Horizontal"
         HorizontalExpand="True"
         MouseFilter="Ignore"
         Margin="0 0 0 5">
    <Button Name="SelectButton" ToggleMode="True" Margin="0 0 5 0" HorizontalExpand="True"/>
    <lobby:HighlightedContainer SetSize="64 64" HorizontalAlignment="Right" UseUiWindowOpacity="True">
        <lobby:HighlightedContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#14171D"
                                   BorderColor="#4E4124"
                                   BorderThickness="1"
                                   ContentMarginTopOverride="4"
                                   ContentMarginBottomOverride="4"
                                   ContentMarginLeftOverride="4"
                                   ContentMarginRightOverride="4"/>
        </lobby:HighlightedContainer.PanelOverride>
        <SpriteView Name="Sprite" Scale="4 4" MouseFilter="Stop"/>
    </lobby:HighlightedContainer>
</BoxContainer>
