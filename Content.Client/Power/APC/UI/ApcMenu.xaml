<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Name="APCMenu"
                      Title="{Loc 'apc-menu-title'}"
                      SetSize="700 430"
                      MinSize="680 414"
                      Resizable="False">
    <BoxContainer Name="RootLayout"
                  Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <PanelContainer Name="RootFrame"
                        HorizontalExpand="True"
                        VerticalExpand="True">
            <BoxContainer Orientation="Vertical"
                          Margin="8 6 8 6"
                          SeparationOverride="8"
                          VerticalExpand="True">
                <PanelContainer Name="HeaderPanel">
                    <BoxContainer Orientation="Vertical"
                                  Margin="10 8 10 8"
                                  SeparationOverride="2">
                        <Label Name="HeaderTitleLabel"
                               Text="{Loc 'apc-menu-title'}"
                               StyleClasses="LabelKeyText" />
                        <RichTextLabel Name="HeaderSubtitleLabel"
                                       Text="{Loc 'apc-menu-header-subtitle'}"
                                       HorizontalExpand="True"
                                       StyleClasses="LabelSubText" />
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Horizontal"
                              SeparationOverride="8"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <PanelContainer Name="DevicePanel"
                                    MinWidth="106"
                                    MaxWidth="116"
                                    VerticalExpand="True">
                        <BoxContainer Orientation="Vertical"
                                      Margin="8 8 8 8"
                                      SeparationOverride="6"
                                      VerticalExpand="True">
                            <PanelContainer Name="DeviceViewportPanel"
                                            MinHeight="90">
                                <SpriteView Name="EntityView"
                                            Scale="2 2"
                                            SetSize="72 72"
                                            OverrideDirection="South"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            </PanelContainer>

                            <Label Name="DeviceSigilLabel"
                                   Align="Center" />
                            <RichTextLabel Name="DeviceCaptionLabel"
                                           HorizontalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Vertical"
                                  SeparationOverride="8"
                                  HorizontalExpand="True"
                                  VerticalExpand="True">
                        <PanelContainer Name="StatusPanel">
                            <BoxContainer Orientation="Vertical"
                                          Margin="10 8 10 8"
                                          SeparationOverride="5">
                                <Label Name="StatusTitleLabel"
                                       StyleClasses="LabelKeyText" />

                                <GridContainer Columns="2"
                                               HSeparationOverride="10"
                                               VSeparationOverride="4">
                                    <Label Name="BreakerKeyLabel"
                                           Text="{Loc 'apc-menu-breaker-label'}" />
                                    <Label Name="BreakerValueLabel"
                                           Text="{Loc 'apc-menu-breaker-state-offline'}"
                                           ClipText="True" />

                                    <Label Name="ExternalKeyLabel"
                                           Text="{Loc 'apc-menu-external-label'}" />
                                    <Label Name="ExternalPowerStateLabel"
                                           Text="{Loc 'apc-menu-power-state-none'}"
                                           ClipText="True" />

                                    <Label Name="LoadKeyLabel"
                                           Text="{Loc 'apc-menu-power-label'}" />
                                    <Label Name="LoadValueLabel"
                                           Text="0"
                                           ClipText="True" />
                                </GridContainer>

                                <RichTextLabel Name="StatusHintLabel"
                                               Text="{Loc 'apc-menu-external-note-none'}"
                                               HorizontalExpand="True"
                                               StyleClasses="LabelSubText" />
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer Name="ChargePanel">
                            <BoxContainer Orientation="Vertical"
                                          Margin="10 8 10 8"
                                          SeparationOverride="5">
                                <BoxContainer Orientation="Horizontal"
                                              SeparationOverride="6">
                                    <Label Name="ChargePanelTitleLabel"
                                           HorizontalExpand="True"
                                           StyleClasses="LabelKeyText" />
                                    <Label Name="ChargePercentageLabel"
                                           Text="0%"
                                           StyleClasses="LabelSubText" />
                                </BoxContainer>

                                <ProgressBar Name="ChargeBar"
                                             HorizontalExpand="True"
                                             MinValue="0"
                                             MaxValue="1"
                                             MinHeight="20"
                                             Value="0" />

                                <RichTextLabel Name="ChargeHintLabel"
                                               Text="{Loc 'apc-menu-charge-note-low'}"
                                               HorizontalExpand="True"
                                               StyleClasses="LabelSubText" />
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer Name="ActionPanel">
                            <BoxContainer Orientation="Vertical"
                                          Margin="10 8 10 8"
                                          SeparationOverride="5">
                                <Label Name="ActionTitleLabel"
                                       StyleClasses="LabelKeyText" />
                                <RichTextLabel Name="ActionHintLabel"
                                               Text="{Loc 'apc-menu-action-note-authorized'}"
                                               HorizontalExpand="True"
                                               StyleClasses="LabelSubText" />
                                <Button Name="BreakerButton"
                                        MinHeight="32"
                                        HorizontalExpand="True"
                                        TextAlign="Center"
                                        Text="{Loc 'apc-menu-breaker-button-enable'}" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Name="FooterWrapper"
                      Orientation="Vertical"
                      VerticalAlignment="Bottom">
            <PanelContainer Name="FooterDivider" />
            <BoxContainer Name="FooterBar"
                          Orientation="Horizontal"
                          Margin="12 0 6 2"
                          VerticalAlignment="Bottom">
                <Label Name="FooterLeftLabel"
                       ClipText="True"
                       Text="{Loc 'apc-menu-footer-ready'}"
                       StyleClasses="WindowFooterText" />
                <Label Name="FooterRightLabel"
                       ClipText="True"
                       Text="{Loc 'apc-menu-footer-right'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right"
                       HorizontalExpand="True"
                       Margin="0 0 4 0" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
