<controls:RoadmapItem
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._WH40K.Roadmap"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Margin="0 0 0 8">
    <PanelContainer Name="CardBackground" Access="Public">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat
                BackgroundColor="#2C2F39"
                BorderColor="#444957"
                BorderThickness="1"
                ContentMarginLeftOverride="6"
                ContentMarginTopOverride="4"
                ContentMarginRightOverride="6"
                ContentMarginBottomOverride="4" />
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Horizontal" SeparationOverride="0">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal">
                    <Label Name="StatusLabel" Access="Public" Margin="0 0 0 4" />
                    <Control HorizontalExpand="True" />
                    <Label Name="StateText" Access="Public" Margin="0 0 2 4" />
                </BoxContainer>
                <Button Name="HeaderButton" Access="Public" StyleClasses="OpenBoth" />
                <BoxContainer Name="ContentsContainer" Access="Public" Orientation="Vertical" Visible="False" Margin="4 4 2 2">
                    <RichTextLabel Name="Contents" Access="Public" RectClipContent="True" />
                </BoxContainer>
            </BoxContainer>

            <PanelContainer Name="StateColor" Access="Public" VerticalExpand="True" MinWidth="6" MaxWidth="6" Margin="6 0 0 0">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat />
                </PanelContainer.PanelOverride>
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</controls:RoadmapItem>
