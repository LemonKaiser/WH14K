<controls:WH40KMortarWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client._WH40K.Mortar"
    Title="{Loc 'wh40k-mortar-interface-title'}"
    MinSize="520 380"
    Access="Public">
    <PanelContainer Margin="6">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat
                BackgroundColor="#141821"
                BorderColor="#465067"
                BorderThickness="2"
                ContentMarginLeftOverride="10"
                ContentMarginTopOverride="10"
                ContentMarginRightOverride="10"
                ContentMarginBottomOverride="10" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat
                            BackgroundColor="#1C222D"
                            BorderColor="#39445A"
                            BorderThickness="1"
                            ContentMarginLeftOverride="6"
                            ContentMarginTopOverride="4"
                            ContentMarginRightOverride="6"
                            ContentMarginBottomOverride="4" />
                    </PanelContainer.PanelOverride>
                    <Label Text="" Access="Public" Name="RangeLabel" />
                </PanelContainer>
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat
                            BackgroundColor="#1C222D"
                            BorderColor="#39445A"
                            BorderThickness="1"
                            ContentMarginLeftOverride="6"
                            ContentMarginTopOverride="4"
                            ContentMarginRightOverride="6"
                            ContentMarginBottomOverride="4" />
                    </PanelContainer.PanelOverride>
                    <Label Text="" Access="Public" Name="CooldownLabel" />
                </PanelContainer>
            </BoxContainer>

            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#1A1F29"
                        BorderColor="#2D3648"
                        BorderThickness="1"
                        ContentMarginLeftOverride="8"
                        ContentMarginTopOverride="6"
                        ContentMarginRightOverride="8"
                        ContentMarginBottomOverride="6" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                    <Label Text="" Access="Public" Name="PositionLabel" />
                    <Label Text="" Access="Public" Name="LoadStateLabel" />
                    <Label Text="" Access="Public" Name="ShellTypeLabel" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#1A1F29"
                        BorderColor="#2D3648"
                        BorderThickness="1"
                        ContentMarginLeftOverride="8"
                        ContentMarginTopOverride="6"
                        ContentMarginRightOverride="8"
                        ContentMarginBottomOverride="6" />
                </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" SeparationOverride="4">
                    <Label Text="" Access="Public" Name="LaserModeLabel" />
                    <Label Text="" Access="Public" Name="LaserStatusLabel" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <LineEdit Name="LaserDesignatorIdInput" Access="Public" HorizontalExpand="True" PlaceHolder="0" />
                        <Button Name="SetLaserDesignatorButton" Access="Public" Text="{Loc 'wh40k-mortar-laser-link-button'}" MinSize="110 0" />
                        <Button Name="ToggleLaserModeButton" Access="Public" Text="{Loc 'wh40k-mortar-laser-toggle-button'}" MinSize="140 0" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="AngleRect">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#1B212B"
                        BorderColor="#37425A"
                        BorderThickness="1"
                        ContentMarginLeftOverride="8"
                        ContentMarginTopOverride="8"
                        ContentMarginRightOverride="8"
                        ContentMarginBottomOverride="8" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <Label Name="TargetTitleLabel" Text="{Loc 'wh40k-mortar-target-title'}" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Label Name="TargetXTitleLabel" Text="{Loc 'wh40k-mortar-target-short-x'}" VerticalAlignment="Center" />
                        <LineEdit Name="TargetXInput" Access="Public" HorizontalExpand="True" PlaceHolder="0" />
                        <Label Text="/" VerticalAlignment="Center" />
                        <Label Name="TargetYTitleLabel" Text="{Loc 'wh40k-mortar-target-short-y'}" VerticalAlignment="Center" />
                        <LineEdit Name="TargetYInput" Access="Public" HorizontalExpand="True" PlaceHolder="0" />
                        <Button Name="SetTargetButton" Access="Public" Text="{Loc 'wh40k-mortar-target-set-button-short'}" MinSize="90 0" StyleClasses="OpenBoth" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="AngleRect">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#1B212B"
                        BorderColor="#37425A"
                        BorderThickness="1"
                        ContentMarginLeftOverride="8"
                        ContentMarginTopOverride="8"
                        ContentMarginRightOverride="8"
                        ContentMarginBottomOverride="8" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <Label Name="DialTitleLabel" Text="{Loc 'wh40k-mortar-dial-title'}" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Label Name="DialXTitleLabel" Text="{Loc 'wh40k-mortar-target-short-x'}" VerticalAlignment="Center" />
                        <LineEdit Name="DialXInput" Access="Public" HorizontalExpand="True" PlaceHolder="0" />
                        <Label Text="/" VerticalAlignment="Center" />
                        <Label Name="DialYTitleLabel" Text="{Loc 'wh40k-mortar-target-short-y'}" VerticalAlignment="Center" />
                        <LineEdit Name="DialYInput" Access="Public" HorizontalExpand="True" PlaceHolder="0" />
                        <Button Name="SetDialButton" Access="Public" Text="{Loc 'wh40k-mortar-dial-set-button-short'}" MinSize="90 0" StyleClasses="OpenBoth" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#37090A"
                        BorderColor="#A73A3D"
                        BorderThickness="2"
                        ContentMarginLeftOverride="6"
                        ContentMarginTopOverride="6"
                        ContentMarginRightOverride="6"
                        ContentMarginBottomOverride="6" />
                </PanelContainer.PanelOverride>
                <Button
                    Name="FireButton"
                    Access="Public"
                    Text="{Loc 'wh40k-mortar-fire-button'}"
                    SetHeight="56"
                    HorizontalExpand="True"
                    StyleClasses="ButtonColorRed" />
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</controls:WH40KMortarWindow>
