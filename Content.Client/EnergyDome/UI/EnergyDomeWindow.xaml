<controls:EnergyDomeWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.EnergyDome.UI"
    xmlns:dome="clr-namespace:Content.Client.EnergyDome.UI.Controls"
    Title="{Loc 'energy-dome-ui-title'}"
    MinSize="840 620"
    Access="Public">
    <PanelContainer Margin="6">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat
                BackgroundColor="#111620"
                BorderColor="#43506A"
                BorderThickness="2"
                ContentMarginLeftOverride="10"
                ContentMarginTopOverride="10"
                ContentMarginRightOverride="10"
                ContentMarginBottomOverride="10" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" SeparationOverride="8">
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#182031"
                        BorderColor="#516182"
                        BorderThickness="1"
                        ContentMarginLeftOverride="8"
                        ContentMarginTopOverride="5"
                        ContentMarginRightOverride="8"
                        ContentMarginBottomOverride="5" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="{Loc 'energy-dome-ui-status-label'}" />
                    <Label Name="StatusValueLabel" Access="Public" />
                    <Control HorizontalExpand="True" />
                    <Button Name="ToggleButton" Access="Public" MinSize="180 0" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" SizeFlagsStretchRatio="1.25">
                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#171f2d"
                                BorderColor="#3f4e68"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <dome:EnergyDomePreviewControl Name="PreviewControl" Access="Public" HorizontalExpand="True" VerticalExpand="True" />
                    </PanelContainer>

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#1A2232"
                                BorderColor="#42526E"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="6">
                            <Label Name="ChargeLabel" Access="Public" />
                            <ProgressBar Name="ChargeBar" Access="Public" MinValue="0" MaxValue="1" HorizontalExpand="True" SetHeight="22" />
                            <Label Name="OverloadLabel" Access="Public" />
                            <ProgressBar Name="OverloadBar" Access="Public" MinValue="0" MaxValue="1" HorizontalExpand="True" SetHeight="22" />
                            <Label Name="PassiveDrawLabel" Access="Public" />
                            <Label Name="UptimeLabel" Access="Public" />
                            <Label Name="CooldownLabel" Access="Public" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#151c2a"
                                BorderColor="#3c4a63"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                            <Label Text="{Loc 'energy-dome-ui-mode-label'}" VerticalAlignment="Center" />
                            <OptionButton Name="ModeOption" Access="Public" HorizontalExpand="True" />
                            <Label Text="{Loc 'energy-dome-ui-size-label'}" VerticalAlignment="Center" />
                            <OptionButton Name="SizeOption" Access="Public" HorizontalExpand="True" />
                            <Label Text="{Loc 'energy-dome-ui-color-label'}" VerticalAlignment="Center" />
                            <OptionButton Name="ColorOption" Access="Public" HorizontalExpand="True" />
                            <Label Text="{Loc 'energy-dome-ui-wall-side-label'}" VerticalAlignment="Center" />
                            <OptionButton Name="WallSideOption" Access="Public" HorizontalExpand="True" />
                            <Label Text="{Loc 'energy-dome-ui-profile-label'}" VerticalAlignment="Center" />
                            <OptionButton Name="ProfileOption" Access="Public" HorizontalExpand="True" />
                        </GridContainer>
                    </PanelContainer>
                </BoxContainer>

                <BoxContainer Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True">
                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#181f2e"
                                BorderColor="#3f4d66"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="6">
                            <Label Text="{Loc 'energy-dome-ui-threat-monitor-title'}" />
                            <Label Name="ThreatHeatLabel" Access="Public" />
                            <ProgressBar Name="ThreatHeatBar" Access="Public" MinValue="0" MaxValue="1" SetHeight="18" />
                            <Label Name="ThreatPiercingLabel" Access="Public" />
                            <ProgressBar Name="ThreatPiercingBar" Access="Public" MinValue="0" MaxValue="1" SetHeight="18" />
                            <Label Name="ThreatOtherLabel" Access="Public" />
                            <ProgressBar Name="ThreatOtherBar" Access="Public" MinValue="0" MaxValue="1" SetHeight="18" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#182030"
                                BorderColor="#40506a"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4">
                            <Label Text="{Loc 'energy-dome-ui-iff-title'}" />
                            <Label Name="FriendlyInsideLabel" Access="Public" />
                            <Label Name="HostileInsideLabel" Access="Public" />
                            <Label Name="LinkedPeersLabel" Access="Public" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#171d2a"
                                BorderColor="#3d4b63"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="6" VerticalExpand="True">
                            <Label Text="{Loc 'energy-dome-ui-linked-map-title'}" />
                            <dome:EnergyDomeLinkedCellMapControl
                                Name="LinkedMapControl"
                                Access="Public"
                                HorizontalExpand="True"
                                VerticalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat
                                BackgroundColor="#161b27"
                                BorderColor="#3f4b60"
                                BorderThickness="1"
                                ContentMarginLeftOverride="8"
                                ContentMarginTopOverride="8"
                                ContentMarginRightOverride="8"
                                ContentMarginBottomOverride="8" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" VerticalExpand="True">
                            <Label Text="{Loc 'energy-dome-ui-recommendations-title'}" />
                            <BoxContainer Name="RecommendationList" Access="Public" Orientation="Vertical" SeparationOverride="2" VerticalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:EnergyDomeWindow>
