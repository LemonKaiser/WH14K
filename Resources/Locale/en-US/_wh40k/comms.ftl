ent-WH40KMegaphone = command megaphone
    .desc = A field loudhailer for short-range order broadcasts.

wh40k-megaphone-dialog-title = Megaphone Broadcast
wh40k-megaphone-dialog-prompt = Enter an order message ({ $max } chars max):

wh40k-megaphone-verb-order-push = Megaphone: Push
wh40k-megaphone-verb-order-hold = Megaphone: Hold
