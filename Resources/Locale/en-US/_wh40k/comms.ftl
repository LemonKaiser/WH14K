wh40k-megaphone-popup-no-orders = No recent nearby orders found.

wh40k-megaphone-replay-header = Recent megaphone orders ({ $count }):
wh40k-megaphone-replay-line = [{ $seconds }s ago] { $speaker }: { $message }

