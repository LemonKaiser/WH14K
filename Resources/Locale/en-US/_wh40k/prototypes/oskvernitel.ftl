ent-MobWH40KOskvernitel = Defiler
    .desc = A daemon engine of Chaos bound into iron and spite. Its corrupted weapon mounts can be cycled between an autocannon and a siege cannon.

ent-WH40KOskvernitelWeaponAutocannon = Defiler autocannon
    .desc = A daemon-forged heavy autocannon that hammers targets with explosive shells.

ent-WH40KOskvernitelWeaponSiegeCannon = Defiler siege cannon
    .desc = A slow but genuinely punishing siege cannon built to smash armor and fortifications.

ent-WH40KDreadnoughtWeaponAssaultCannon = Dreadnought assault cannon
    .desc = A high-rate assault cannon with a massive ammunition reserve for sustained anti-infantry fire.

ent-WH40KDreadnoughtWeaponMissileRack = Dreadnought missile rack
    .desc = A six-shot missile rack that unloads a full salvo before rearming.

ent-ActionWH40KOskvernitelOpenWeaponMenu = Weapon Selector
    .desc = Switch between the Defiler's gun mounts.
