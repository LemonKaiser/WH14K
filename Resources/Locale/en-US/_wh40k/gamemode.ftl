wh40k-team-battle-title = WH40K Team Battle
wh40k-team-battle-description = Two factions fight for total victory. Teams are assigned by department.
wh40k-team-imperium = Imperium
wh40k-team-heretics = Heretics

wh40k-team-assigned = You are on the { $team } team.
wh40k-team-service-message = You have been called to serve the { $team }. Hold the line.
wh40k-team-service-message-Imperium = By the Emperor's will, scour this world of heresy. No mercy. No retreat.
wh40k-team-service-message-Heretics = Let the Imperium fall. Slay the Emperor's faithful and drown the soil in their blood.
wh40k-ahelp-friendly-fire-warning = Automatic warning: you damaged a teammate. Friendly fire is not allowed if your role does not permit it. This is a rules violation.
wh40k-team-winner-announce = { $team } wins the battle!
wh40k-team-draw-announce = The battle ends in a draw.
wh40k-team-time-limit-announce = Time limit reached. The battle ends in a draw.
wh40k-team-round-end-header = [bold][color=gold]+++ Battle Report +++[/color][/bold]
wh40k-team-round-end-summary = [color=gray]The guns fall silent. The tally of the fallen is complete.[/color]
wh40k-team-round-end-summary-2 = [color=gray]Command files the final report below.[/color]
wh40k-team-round-end-winner = [bold]Winner:[/bold] [color=gold]{ $team }[/color]
wh40k-team-round-end-draw = [bold][color=yellow]Result:[/color][/bold] Draw
wh40k-team-round-end-time-limit = [color=yellow]Time limit reached - the war grinds into a stalemate.[/color]
wh40k-team-round-end-team-line = [bold]{ $team }[/bold] - [color=gray]Total: { $total }[/color] / [color=green]Alive: { $alive }[/color] - [color=red]Losses: { $deaths }[/color] - [color=orange]Kills: { $kills }[/color]
wh40k-team-round-end-top-header = [bold][color=white]Top killers[/color][/bold]:
wh40k-team-round-end-top-entry = { $place }. [color=white]{ $name }[/color] - [color=orange]{ $kills } kills[/color]
