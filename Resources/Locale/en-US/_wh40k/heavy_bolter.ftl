wh40k-heavy-bolter-verb-deploy = Deploy heavy bolter
wh40k-heavy-bolter-verb-fold = Fold heavy bolter

wh40k-heavy-bolter-deploy-start = You start deploying {$bolter}.
wh40k-heavy-bolter-deploy-finish-self = You deploy {$bolter}.
wh40k-heavy-bolter-deploy-finish-others = {$user} deploys {$bolter}.

wh40k-heavy-bolter-fold-start = You start folding {$bolter}.
wh40k-heavy-bolter-fold-finish-self = You fold {$bolter}.
wh40k-heavy-bolter-fold-finish-others = {$user} folds {$bolter}.

wh40k-heavy-bolter-not-deployed = You need to deploy {$bolter} first.
wh40k-heavy-bolter-operator-required = You need to stand behind the heavy bolter to fire it.
wh40k-heavy-bolter-operator-space-blocked = Cannot mount the heavy bolter: rear operator spot is occupied.
wh40k-heavy-bolter-operator-space-blocked-wall = No room behind the heavy bolter: a wall is blocking the operator spot.
wh40k-heavy-bolter-deploy-space-blocked = Cannot deploy the heavy bolter here: a wall is blocking placement.
wh40k-heavy-bolter-rotate-space-blocked = Cannot rotate the heavy bolter: operator spot would be blocked.
wh40k-heavy-bolter-arc-limit = Target is outside the heavy bolter firing arc.
wh40k-heavy-bolter-toggle-cooldown = Mechanism cooldown: {$seconds}s.

ent-WH40KHeavyBolter = heavy bolter emplacement
    .desc = Crew-operated heavy bolter. Deploy it, take position behind the gun, and suppress the lane.

ent-WH40KMagazineHeavyBolter = heavy bolter magazine
    .desc = A 100-round belt box for the heavy bolter.

ent-CartridgeHeavyBolter = heavy bolter round
    .desc = A heavy bolt round for a crew-served heavy bolter.

ent-ActionWH40KHeavyBolterRotateLeft = rotate left
    .desc = Rotate the mounted heavy bolter to the left.

ent-ActionWH40KHeavyBolterRotateRight = rotate right
    .desc = Rotate the mounted heavy bolter to the right.

ent-WH40KAutocannon = autocannon emplacement
    .desc = Crew-operated autocannon. Deploy it, take position behind the gun, and hammer armored targets and fortified lanes.

ent-WH40KMagazineAutocannon = autocannon box
    .desc = A 50-round belt box for the autocannon.

ent-CartridgeAutocannon = autocannon round
    .desc = A heavy round for a crew-served autocannon.
