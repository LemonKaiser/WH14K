uniform sampler2D SCREEN_TEXTURE;

const highp float Desaturation = 0.08;
const highp float VignetteInner = 0.36;
const highp float VignetteOuter = 1.08;
const highp float VignetteDarkness = 0.28;

void fragment()
{
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp vec4 src = zTextureSpec(SCREEN_TEXTURE, uv);

    highp float luma = dot(src.rgb, vec3(0.299, 0.587, 0.114));
    highp vec3 color = mix(src.rgb, vec3(luma), Desaturation);

    highp vec2 centered = uv * 2.0 - 1.0;
    centered.x *= SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
    highp float vignette = smoothstep(VignetteInner, VignetteOuter, length(centered));
    color *= 1.0 - vignette * VignetteDarkness;

    COLOR = vec4(clamp(color, 0.0, 1.0), src.a);
}
